diff --git a/lib/src/aia.h b/lib/src/aia.h
index 046c218..4b2f204 100644
--- a/lib/src/aia.h
+++ b/lib/src/aia.h
@@ -10,6 +10,24 @@
 #include <stdint.h>
 #include <stdio.h>
 #include <curl/curl.h>
+#include <stdlib.h>
+
+#if defined(__APPLE__)
+/*
+ * Shiro (iOS): OpenSSL-backed libcurl has no access to the iOS trust store and
+ * chiaki's AIA chain recovery derives its trust store from CURLOPT_CAINFO.
+ * Point every handle at the CA bundle the app exports in SSL_CERT_FILE.
+ */
+static inline CURL *shiro_curl_easy_init_with_ca(void)
+{
+	CURL *handle = (curl_easy_init)();
+	const char *ca = getenv("SSL_CERT_FILE");
+	if(handle && ca && *ca)
+		curl_easy_setopt(handle, CURLOPT_CAINFO, ca);
+	return handle;
+}
+#define curl_easy_init() shiro_curl_easy_init_with_ca()
+#endif
 
 #ifdef __cplusplus
 extern "C" {
diff --git a/lib/src/aia_openssl.c b/lib/src/aia_openssl.c
index d3b36f2..8e3048f 100644
--- a/lib/src/aia_openssl.c
+++ b/lib/src/aia_openssl.c
@@ -76,6 +76,12 @@ void *chiaki_aia_trust_store(CURL *connection)
 	if(curl_easy_getinfo(connection, CURLINFO_CAINFO, &file) != CURLE_OK ||
 		curl_easy_getinfo(connection, CURLINFO_CAPATH, &path) != CURLE_OK)
 		goto error;
+#if defined(__APPLE__)
+	/* CURLINFO_CAINFO reports curl's compile-time default, not the per-handle
+	 * CURLOPT_CAINFO. On iOS there is no default; use the app's CA bundle. */
+	if(!file && !path)
+		file = getenv("SSL_CERT_FILE");
+#endif
 #ifdef _WIN32
 	const curl_version_info_data *version = curl_version_info(CURLVERSION_NOW);
 	if(version->ssl_version && strstr(version->ssl_version, "Schannel") && !file) {
